{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true,
    "mocha": true
  },
  "ignorePatterns": ["/_site", "tests/"],
  "extends": ["eslint-config-airbnb-base", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "env": {
        "jest": true
      }
    }
  ],
  "rules": {
    "no-param-reassign": ["error", { "props": false }],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "no-iterator": ["off"],
    "no-return-await": ["off"]
  }
}
